          "money": {
            "gte": 25
          }
        },
        "now": [
          {
            "money": -25
          },
          {
            "trust": "yusuf",
            "by": 1
          }
        ],
        "later": [
          {
            "in": 3,
            "card": "yusuf-aleppo"
          }
        ]
      },
      {
        "id": "keep",
        "label": "Keep to the paper",
        "hint": "Yusuf will keep his word.",
        "now": [],
        "later": [
          {
            "in": 2,
            "do": [
              {
                "trust": "yusuf",
                "by": -1
              }
            ]
          }
