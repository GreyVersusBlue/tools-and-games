---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
layout: false
---
{#- collections.sitemap (eleventy.config.mjs) is every published page's URL in a
    stable order. No <lastmod>: it would have to come from file dates, which a
    git clone does not preserve. -#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for pageUrl in collections.sitemap %}
  <url><loc>{{ site.origin }}{{ pageUrl | url }}</loc></url>
{%- endfor %}
</urlset>
