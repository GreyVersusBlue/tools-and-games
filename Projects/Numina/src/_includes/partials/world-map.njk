    <g class="map-compass" transform="translate(898,404)" aria-hidden="true">
      <circle class="compass-ring" r="44"/>
      <circle class="compass-ring" r="39" stroke-dasharray="2 4"/>
      <path class="compass-dark" d="M0 -40 L6.5 -6.5 L40 0 L6.5 6.5 L0 40 L-6.5 6.5 L-40 0 L-6.5 -6.5 Z"/>
      <path class="compass-light" transform="rotate(45)" d="M0 -27 L5 -5 L27 0 L5 5 L0 27 L-5 5 L-27 0 L-5 -5 Z"/>
      <circle class="compass-light" r="3.6"/>
      <text x="0" y="-51" text-anchor="middle">N</text>
    </g>

    <g class="map-cartouche" aria-hidden="true">
      <path class="cartouche-curl" d="M806 52 Q794 58 791 88 Q789 118 801 126 Q796 92 806 52 Z"/>
      <path class="cartouche-curl" d="M970 52 Q983 60 985 90 Q986 118 974 126 Q980 92 970 52 Z"/>
      <path class="cartouche-scroll" d="M806 52 Q890 45.5 970 52 Q977 89 970 128 Q890 134.5 806 128 Q799 89 806 52 Z"/>
      <path class="cartouche-inner" d="M814 60 Q890 54.5 962 60 Q968 89 962 120 Q890 125.5 814 120 Q808 89 814 60 Z"/>
      <path class="cartouche-sprig" d="M874 67 Q880 61.5 887.5 62.5 Q882.5 68 875.5 68.5 Z"/>
      <path class="cartouche-sprig" d="M902 67 Q896 61.5 888.5 62.5 Q893.5 68 900.5 68.5 Z"/>
      <text class="map-title" x="888" y="102" text-anchor="middle">AELEDD</text>
      <text class="map-subtitle" x="888" y="119" text-anchor="middle">The Known Nations</text>
    </g>

    <g class="map-frame" aria-hidden="true">
      <rect class="frame-outer" x="9" y="9" width="982" height="682"/>
      <rect class="frame-inner" x="17" y="17" width="966" height="666"/>
      <use href="#c-frame"/>
      <use href="#c-frame" transform="translate(1000,0) scale(-1,1)"/>
      <use href="#c-frame" transform="translate(0,700) scale(1,-1)"/>
      <use href="#c-frame" transform="translate(1000,700) scale(-1,-1)"/>
    </g>
  </svg>
  <figcaption>The nations of Aeledd <span class="world-map__note">(placeholder geography — select a nation to read its chapter)</span></figcaption>
</figure>
