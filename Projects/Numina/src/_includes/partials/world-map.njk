<figure class="world-map{{ ' ' + mapClass if mapClass }}">
  <svg viewBox="0 0 1000 700" role="img" aria-label="Map of the nations of Aeledd">
    <defs>
      <filter id="map-rough" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.014 0.02" numOctaves="2" seed="7" result="n"/>
        <feDisplacementMap in="SourceGraphic" in2="n" scale="7"/>
      </filter>
      <filter id="map-grain" x="0" y="0" width="100%" height="100%">
        <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" seed="3"/>
        <feColorMatrix values="0 0 0 0 0.34 0 0 0 0 0.26 0 0 0 0 0.11 0 0 0 0.055 0"/>
      </filter>
      <path id="aeledd-land" d="M 140 62 Q 300 48 450 58 Q 620 50 745 72 Q 782 180 770 300 Q 778 420 735 505 Q 640 528 505 522 Q 492 575 480 632 Q 300 655 125 640 Q 88 500 82 360 Q 76 200 96 100 Q 115 70 140 62 Z"/>
      <g id="g-mtn">
        <path d="M0 14 Q4 8 7.2 0 Q10 8 15 14 Z"/>
        <path d="M7.2 2.5 L9.6 9.5" fill="none" stroke-width="0.9"/>
      </g>
      <g id="g-tree">
        <path d="M4.5 13 L4.5 9" fill="none" stroke-width="1.1"/>
        <path d="M4.5 0 Q8.6 5 7.4 9.2 Q4.5 11.2 1.6 9.2 Q0.4 5 4.5 0 Z"/>
      </g>
      <g id="g-wave">
        <path d="M0 3 Q4 0 8 3 Q12 6 16 3" fill="none" stroke-width="1.3"/>
        <path d="M3 7 Q7 4.5 11 7" fill="none" stroke-width="1"/>
      </g>
      {# Children of <use> clones live in a shadow tree that CSS selectors
         cannot reach, so the corner ornament is styled inline with vars. #}
      <g id="c-frame">
        <path style="fill:none;stroke:var(--map-gold);stroke-width:1.8" d="M17 62 Q20 33 37 24.5 Q51 17.5 64 17"/>
        <path style="fill:none;stroke:var(--map-gold);stroke-width:1.4" d="M24.5 53 Q28.5 37.5 41 31"/>
        <path style="fill:var(--map-gold)" d="M37 24.5 Q45 15 55.5 14 Q49.5 23.5 39 26.5 Z"/>
        <circle style="fill:var(--map-gold)" cx="24.5" cy="53" r="2.1"/>
      </g>
    </defs>

    <rect class="map-sea" x="0" y="0" width="1000" height="700"/>
    <rect class="map-grain" x="0" y="0" width="1000" height="700" filter="url(#map-grain)"/>

    <g class="map-waves" aria-hidden="true">
      <use href="#g-wave" transform="translate(806,168)"/>
      <use href="#g-wave" transform="translate(852,146) scale(0.85)"/>
      <use href="#g-wave" transform="translate(930,166) rotate(-3)"/>
      <use href="#g-wave" transform="translate(800,352) scale(0.9)"/>
      <use href="#g-wave" transform="translate(958,352) rotate(4)"/>
      <use href="#g-wave" transform="translate(796,438) scale(0.8)"/>
      <use href="#g-wave" transform="translate(806,616) rotate(-4)"/>
      <use href="#g-wave" transform="translate(884,636) scale(0.9)"/>
      <use href="#g-wave" transform="translate(946,606)"/>
      <use href="#g-wave" transform="translate(180,666) scale(0.9)"/>
      <use href="#g-wave" transform="translate(422,672) rotate(3)"/>
      <use href="#g-wave" transform="translate(650,664) scale(0.85)"/>
      <use href="#g-wave" transform="translate(900,60) scale(0.8) rotate(-2)"/>
      <use href="#g-wave" transform="translate(48,300) scale(0.75)"/>
      <use href="#g-wave" transform="translate(44,470) scale(0.85) rotate(4)"/>
    </g>

    <use href="#aeledd-land" class="map-coast map-coast--3" filter="url(#map-rough)"/>
    <use href="#aeledd-land" class="map-coast map-coast--2" filter="url(#map-rough)"/>
    <use href="#aeledd-land" class="map-coast map-coast--1" filter="url(#map-rough)"/>
    <use href="#aeledd-land" class="map-land" filter="url(#map-rough)"/>

    {% for n in collections.nations %}
    {% set slug = n.fileSlug %}
    {% if mapPaths[slug] %}
    <a href="{{ n.url }}" class="map-region" style="--nation-color: {{ n.data.color }}">
      <path d="{{ mapPaths[slug] }}"/>
      <title>{{ n.data.name }} — {{ n.data.summary }}</title>
      <text x="{{ mapLabels[slug][0] }}" y="{{ mapLabels[slug][1] }}" text-anchor="middle">{{ mapShorts[slug] }}</text>
    </a>
    {% endif %}
    {% endfor %}

    <g class="map-decor" aria-hidden="true">
      <use href="#g-mtn" transform="translate(132,190) scale(1.9)"/>
      <use href="#g-mtn" transform="translate(166,184) scale(2.4)"/>
      <use href="#g-mtn" transform="translate(210,192) scale(1.7) rotate(-3)"/>
      <use href="#g-mtn" transform="translate(254,196) scale(2.1)"/>
      <use href="#g-mtn" transform="translate(292,193) scale(1.6) rotate(4)"/>
      <use href="#g-mtn" transform="translate(424,192) scale(2.2)"/>
      <use href="#g-mtn" transform="translate(462,188) scale(1.8)"/>
      <use href="#g-mtn" transform="translate(494,196) scale(2) rotate(-4)"/>
      <use href="#g-mtn" transform="translate(592,198) scale(1.7)"/>
      <use href="#g-mtn" transform="translate(622,190) scale(2.3)"/>
      <use href="#g-mtn" transform="translate(662,197) scale(1.8) rotate(3)"/>
      <use href="#g-mtn" transform="translate(700,200) scale(1.9)"/>
      <use href="#g-tree" transform="translate(296,316) scale(1.7)"/>
      <use href="#g-tree" transform="translate(316,326) scale(1.4)"/>
      <use href="#g-tree" transform="translate(334,314) scale(1.6) rotate(-4)"/>
      <use href="#g-tree" transform="translate(352,327) scale(1.8)"/>
      <use href="#g-tree" transform="translate(184,466) scale(1.7)"/>
      <use href="#g-tree" transform="translate(204,476) scale(1.4) rotate(4)"/>
      <use href="#g-tree" transform="translate(222,464) scale(1.75)"/>
      <use href="#g-tree" transform="translate(606,246) scale(1.5)"/>
      <use href="#g-tree" transform="translate(624,236) scale(1.75) rotate(-3)"/>
      <use href="#g-tree" transform="translate(644,248) scale(1.45)"/>
      <g class="map-beast" transform="translate(586,568) scale(1.2)">
        <path class="beast-line" d="M12 16 Q20 3 28 16 M36 16 Q44 5 52 16 M60 16 Q66 8 72 16 Q76 11 80 12"/>
        <path class="beast-solid" d="M12 16 Q5 15.5 2 10.5 Q5 5.5 10.5 7.5 Q13.5 11 12 16 Z"/>
        <circle class="beast-eye" cx="7.2" cy="9.2" r="0.9"/>
      </g>
      <g class="map-beast" transform="translate(706,576) scale(1.15)">
