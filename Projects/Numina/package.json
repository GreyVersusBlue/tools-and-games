{
  "name": "numina-site",
  "private": true,
  "type": "module",
  "description": "Numina LARP reference site — Eleventy source in src/, built output committed at the project root.",
  "scripts": {
    "clean": "node tools/clean.mjs",
    "build": "npm run clean && eleventy && pagefind --site . --glob \"{index.html,{lore,mechanics,search}/**/*.html}\"",
    "serve": "eleventy --serve",
    "test": "node test/smoke.mjs"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "markdown-it-anchor": "^9.2.1",
    "pagefind": "^1.5.2"
  }
}
