---
layout: layouts/base.njk
title: Search
---
<div class="shell shell--single">
  <main id="main" tabindex="-1">
    <h1>Search</h1>
    <link rel="stylesheet" href="/pagefind/pagefind-ui.css">
    <div id="search"></div>
    <noscript><p>Search needs JavaScript. Try the <a href="/lore/">Lore</a> and <a href="/mechanics/">Mechanics</a> indexes instead.</p></noscript>
    <script src="/pagefind/pagefind-ui.js"></script>
    <script>
      window.addEventListener("DOMContentLoaded", function () {
        var ui = new PagefindUI({
          element: "#search",
          bundlePath: "../pagefind/",
          showSubResults: true,
          showImages: false
        });
        // Pagefind's own input carries a title and no label, which is the one
        // thing on this site whose markup we do not write. The widget is
        // constructed synchronously into #search, so the input exists by now.
        var input = document.querySelector("#search .pagefind-ui__search-input");
        if (input) input.setAttribute("aria-label", "Search the site");
        var q = new URLSearchParams(location.search).get("q");
        if (q) ui.triggerSearch(q);
      });
    </script>
  </main>
</div>
