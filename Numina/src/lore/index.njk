---
layout: layouts/base.njk
title: Lore
section: Lore
---
<div class="shell">
  {% include "partials/sidebar.njk" %}
  <main>
    <h1>Lore of Aeledd</h1>
    <p class="lede">Everything from the Numina campaign guide: the world, its sixteen nations,
    its peoples and faiths, the Lattice that binds it together, and the history that brought
    it to the Age of Works.</p>
    {% include "partials/ornaments/divider.njk" %}
    <div class="card-grid">
      {% set navSection = nav.sections | sectionForTitle("Lore") %}
      {% for pg in navSection.pages %}
      {% set entry = collections.all | pageByUrl(pg.url) %}
      <a class="card" href="{{ pg.url }}">
        <h2>{{ pg.title }}</h2>
        {% if entry %}<p>{{ entry.data.summary }}</p>{% endif %}
      </a>
      {% endfor %}
    </div>
  </main>
</div>
